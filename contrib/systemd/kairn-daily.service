# kairn 日次同期（bag2zst -> checkin -> raw-move -> drive-index -> index）。
# 置き場: ~/.config/systemd/user/kairn-daily.service
# <workspace> は利用者が自分のワークスペース名（kairn ws list）に書き換える。
# 複数ワークスペースを回すなら ExecStart 行を増やす（順に実行される）。
[Unit]
Description=kairn daily sync (bag2zst, checkin, raw-move, drive-index, index)
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/kairn/.venv/bin/kairn daily <workspace>
# ログは journalctl --user -u kairn-daily と <data>/<workspace>/index/daily.log
