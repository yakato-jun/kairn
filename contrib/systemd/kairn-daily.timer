# kairn 日次同期のタイマー（毎日 12:30。停止中だった分は次回起動時に実行）。
# 置き場: ~/.config/systemd/user/kairn-daily.timer
# 有効化: systemctl --user daemon-reload && systemctl --user enable --now kairn-daily.timer
[Unit]
Description=Run kairn daily sync at 12:30

[Timer]
OnCalendar=*-*-* 12:30:00
Persistent=true
RandomizedDelaySec=10m

[Install]
WantedBy=timers.target
