# kairn の MCP サーバー＋ローカル UI の常駐（kairn serve: MCP http://127.0.0.1:8765/mcp、UI http://127.0.0.1:8765/ui）。
# 置き場: ~/.config/systemd/user/kairn-serve.service
# 有効化: systemctl --user daemon-reload && systemctl --user enable --now kairn-serve.service
# ExecStart の %h/kairn は clone 先。clone 先が異なる環境では %h/kairn を書き換える（uv sync 済みの .venv を使う）。
# ポートを変える場合は ExecStart に --port <n> を付け、各エージェントの MCP 登録 URL も合わせる。
[Unit]
Description=kairn MCP server and local UI (kairn serve)
After=network-online.target

[Service]
Type=simple
ExecStart=%h/kairn/.venv/bin/kairn serve
Restart=on-failure
RestartSec=5
# ログは journalctl --user -u kairn-serve

[Install]
WantedBy=default.target
